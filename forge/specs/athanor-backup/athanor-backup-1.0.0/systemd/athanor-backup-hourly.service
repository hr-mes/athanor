[Unit]
Description=Athanor OS hourly snapshot of /var/home
Documentation=man:btrfs-subvolume(8)
# The snapshot directory is a btrfs subvolume created by tmpfiles.d (athanor-backup.conf).
After=systemd-tmpfiles-setup.service
RequiresMountsFor=/var/home

[Service]
Type=oneshot
ExecStart=/usr/bin/athanor-backup create
ExecStart=/usr/bin/athanor-backup prune
CPUWeight=50
IOWeight=50
MemoryHigh=48M
MemoryMax=64M

# Snapshotting needs CAP_FOWNER on the source subvolume, deleting one CAP_SYS_ADMIN.
# The live homes stay read-only: only the snapshot subvolume is writable.
CapabilityBoundingSet=CAP_FOWNER CAP_SYS_ADMIN
ProtectSystem=strict
ReadWritePaths=/var/home/.snapshots
PrivateTmp=true
PrivateNetwork=true
NoNewPrivileges=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
