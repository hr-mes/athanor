[Unit]
Description=COSMIC panel, dock and notification daemon
Documentation=https://github.com/pop-os/cosmic-panel
After=graphical-session.target athanor-desktop.service athanor-skel-sync.service
Requisite=athanor-desktop.service
PartOf=graphical-session.target

[Service]
# One process draws every entry of /usr/share/cosmic/com.system76.CosmicPanel (the top
# panel and the dock) and spawns the applets as its children, so they live and are
# accounted for in this unit's cgroup.
#
# ExecStart is athanor-cosmic-panel, which starts cosmic-notifications beside the panel
# on a shared socket pair. The panel reaches the notification daemon over an inherited
# descriptor, never over the session bus, so the two have to share a parent and systemd
# cannot be it; the script says the rest. The daemon is a plain child of the wrapper,
# inside this unit and this cgroup, the way cosmic-session runs it, and
# cosmic-notifications.service is gone.
#
# What that costs, plainly: a notification daemon that runs away is charged here, and if
# it pushes the unit past MemoryMax the kernel picks a task in this cgroup to kill. The
# wrapper puts the daemon's oom_score_adj back to zero so that it, and not the panel
# behind OOMScoreAdjust=-500, is the one taken -- but that is a preference, not a
# guarantee, and before the two shared a unit a runaway daemon could only ever have
# killed itself. The daemon also loses the unit sandbox cosmic-notifications.service gave
# it; the wrapper keeps it no_new_privs and a 0077 umask and nothing else, because the
# rest is applied by systemd while exec'ing a unit and the daemon is no longer one. A
# transient scope of its own was tried and reverted: a sibling cgroup put the daemon
# outside the panel's lifecycle, so a panel restart or a session teardown left it running
# and contending for org.freedesktop.Notifications.
#
# W^X cannot hold for a GL client: Mesa JIT-compiles shaders on the CPU wherever there
# is no GPU driver (llvmpipe, the case of every VM), and the freshly written page must
# then become executable; acceptance run 34524538068 saw every start of a GL client
# segfault at the first JIT'd function with it on.
MemoryDenyWriteExecute=no
CPUWeight=200

# The budget covers two programs. cosmic-notifications.service had MemoryHigh=256M and
# MemoryMax=384M of its own and the panel had 1G and 1536M; in one cgroup that is
# 1G + 256M = 1280M and 1536M + 384M = 1920M. Leaving the panel's old numbers would charge
# the daemon's working set against the limit oomd already killed the panel at once.
MemoryHigh=1280M
MemoryMax=1920M
OOMScoreAdjust=-500
Type=simple
Slice=session.slice
ExecStart=/usr/bin/athanor-cosmic-panel
Restart=on-failure
RestartSec=2s

# The panel is the launcher: the app list, the dock and the launcher applet fork the
# user's applications as children of this process, and a child keeps its parent's mount
# namespace, no_new_privs flag and seccomp filter for life. Under the daemon sandbox the
# other COSMIC units carry, every application opened from the panel saw a read-only
# filesystem (ProtectSystem=strict, ProtectHome=read-only), could not sudo
# (NoNewPrivileges, RestrictSUIDSGID) and ran under a system-call filter written for the
# panel. A transient scope would not help: it moves the child's cgroup, not its namespace.
# The same goes for every seccomp-based directive (RestrictRealtime, LockPersonality):
# a filter installed here is a filter on every application, and the image grants users
# realtime scheduling on purpose (99-athanor-realtime.conf). So the panel keeps its
# resource controls and nothing that propagates; applications are confined by their own
# compartment, not by the launcher's unit.
#
# cosmic-config keeps the panel's and the applets' settings in $XDG_CONFIG_HOME/cosmic,
# and their state in $XDG_STATE_HOME/cosmic.
ConfigurationDirectory=cosmic
StateDirectory=cosmic

[Install]
WantedBy=graphical-session.target
