[Unit]
Description=Athanor OS Desktop Panel (Pure Rust Native Shell)
Documentation=https://github.com/hr-mes/athanor-forge
After=graphical-session.target athanor-desktop.service athanor-skel-sync.service
Requisite=athanor-desktop.service
PartOf=graphical-session.target

[Service]
MemoryDenyWriteExecute=true
CPUWeight=200
MemoryHigh=768M
MemoryMax=1024M
OOMScoreAdjust=-500
Type=simple
Slice=session.slice
ExecStart=/usr/bin/athanor-shell-rs
Restart=on-failure
RestartSec=2s

# Extreme Sandboxing
ProtectSystem=strict
ProtectHome=read-only
# The shell's own files under the read-only home: widgets.json in
# $XDG_CONFIG_HOME/athanor, the notification history in $XDG_STATE_HOME/athanor.
ConfigurationDirectory=athanor
StateDirectory=athanor
PrivateTmp=true
NoNewPrivileges=true
# mincore is no longer part of @system-service, and the GL stack calls it while the
# first frame is drawn: acceptance run 34515239432 recorded every shell start dying
# on it (SECCOMP syscall=27) under this filter.
SystemCallFilter=@system-service mincore
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=graphical-session.target
