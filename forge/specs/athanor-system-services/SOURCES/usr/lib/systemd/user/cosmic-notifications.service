[Unit]
Description=COSMIC notifications
Documentation=https://github.com/pop-os/cosmic-notifications
After=graphical-session.target athanor-desktop.service
Requisite=athanor-desktop.service
PartOf=graphical-session.target

[Service]
# See cosmic-panel.service for the GL client settings (W^X, mincore).
MemoryDenyWriteExecute=no
MemoryHigh=256M
MemoryMax=384M
Type=simple
Slice=session.slice
ExecStart=/usr/bin/cosmic-notifications
Restart=on-failure
RestartSec=2s

ProtectSystem=strict
ProtectHome=read-only
ConfigurationDirectory=cosmic
StateDirectory=cosmic
PrivateTmp=true
NoNewPrivileges=true
SystemCallFilter=@system-service mincore
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=graphical-session.target
