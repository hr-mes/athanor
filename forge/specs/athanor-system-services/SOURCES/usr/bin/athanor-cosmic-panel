#!/usr/bin/python3
"""athanor-cosmic-panel - cosmic-panel and cosmic-notifications over one socket pair.

The notifications applet in the panel does not reach the notification daemon over the
session bus. cosmic-notifications serves it a second, peer-to-peer D-Bus connection on
an unnamed socket pair and hands the applet its own descriptor over it
(com.system76.NotificationsSocket.GetFd). Upstream, cosmic-session creates the pair and
starts both programs itself, naming each end in the child's environment:
PANEL_NOTIFICATIONS_FD for the panel, DAEMON_NOTIFICATIONS_FD for the daemon
(cosmic-session, src/notifications.rs).

A descriptor is inherited, never looked up, so the two programs must share a parent.
Ours did not: both were systemd user units, and systemd has no way to hand the same
socket pair to two of them. The daemon logged "Failed to setup panel dbus server
DAEMON_NOTIFICATIONS_FD is not set", the panel "Failed to connect to the notifications
daemon", and the notifications applet was never started -- the session owned the
org.freedesktop.Notifications name and displayed nothing.

This is that parent, and it runs as cosmic-panel.service, so the panel keeps the unit it
is tuned for: the resource controls that stopped oomd from killing it, and the
deliberate absence of the sandbox directives that would otherwise propagate to every
application launched from the dock.

The panel is what the session cannot lose, so this process exits only when the panel
exits; the unit's Restart= never sees a failing daemon. A daemon that dies is restarted
here, on a new socket pair -- and so is the panel, which is not a choice: the panel holds
its end of the dead pair for life, the descriptor number in its environment never
changes, and nothing in it can reconnect. cosmic-session force-restarts the other side
for the same reason. Restarts back off 1, 2, 4 ... up to 60 seconds; five exits inside
ten minutes and the daemon is given up on, logged at err priority, and the panel runs
alone for the rest of the session -- a session without notifications, rather than a panel
that disappears every minute.
"""

import ctypes
import os
import socket
import subprocess
import sys
import time

DAEMON = "/usr/bin/cosmic-notifications"
PANEL = "/usr/bin/cosmic-panel"

# GIVE_UP_AFTER exits inside FAILURE_WINDOW_SECONDS and the daemon is dropped for the
# rest of the session. A sliding window rather than a run of consecutive short runs: the
# rule used to be "a run longer than 60 seconds clears the count", and a daemon that died
# every 61 seconds -- the shape of a leak, or of a driver that gives out after a while --
# cleared it every time and restarted the panel once a minute for as long as the session
# lasted, never reaching the give-up at all. Ten minutes is wide enough that no such cycle
# can outrun it: at one exit a minute the fifth falls inside the window with five minutes
# to spare. A daemon that fails less often than five times in ten minutes is worth
# restarting, and the window forgets it.
FAILURE_WINDOW_SECONDS = 600
GIVE_UP_AFTER = 5
BACKOFF_CEILING_SECONDS = 60

# systemd reads a <N> prefix on a line of a service's output as its syslog priority
# (SyslogLevelPrefix, on by default), so the one line that has to stand out in the
# journal does, without another process to write it. It only reads the prefix at the
# very start of the line, before anything else.
ERR = "<3>"
INFO = "<6>"

# How long a program gets to answer SIGTERM before it is killed. Without a bound, one
# child ignoring SIGTERM would hang this process and the unit would never restart.
TERMINATE_TIMEOUT_SECONDS = 10

# The daemon runs in a transient scope of its own, so that its memory is its own problem.
# In one cgroup with the panel, a daemon that ran away would push cosmic-panel.service
# past MemoryMax and the kernel would pick the largest task in the cgroup -- the panel --
# while the daemon sat behind the panel's inherited OOMScoreAdjust=-500. Its own
# MemoryMax is the limit cosmic-notifications.service used to carry, so a runaway daemon
# is killed inside its own scope and the session keeps its panel.
#
# systemd-run --scope execs the command in its own process rather than handing it to the
# manager, so the socket descriptor, the environment and no_new_privs all pass straight
# through and the pid waited on here is the daemon's own. It needs the user bus, which
# every user unit is given. Verified from inside a transient user unit: the descriptor
# arrives, the process lands in its own scope cgroup, and its comm is the daemon's.
DAEMON_SCOPE = [
    "systemd-run",
    "--user",
    "--scope",
    "--quiet",
    "--description=COSMIC notifications",
    "--property=MemoryHigh=256M",
    "--property=MemoryMax=384M",
    "--",
]

PR_SET_NO_NEW_PRIVS = 38  # linux/prctl.h

# Opened here, in the parent, so that harden() -- which runs in the forked child, where
# dlopen is not safe to call -- only has to make the syscall.
_LIBC = ctypes.CDLL(None, use_errno=True)


def log(message, priority=INFO):
    print(f"{priority}athanor-cosmic-panel: {message}", file=sys.stderr, flush=True)


def harden():
    """Confine the daemon, in the child, between fork and exec.

    cosmic-notifications parses the summary, the body and the image of every
    notification any application sends, and it used to carry a unit sandbox. Sharing a
    socket pair with the panel costs it that unit, and most of what the unit gave it
    cannot be reproduced from here: ProtectSystem=strict, ProtectHome=read-only,
    PrivateTmp and the ProtectKernel*/ProtectControlGroups directives are mount
    namespaces, and SystemCallFilter=@system-service, RestrictRealtime,
    RestrictSUIDSGID and LockPersonality are seccomp filters -- systemd installs all of
    them while exec'ing a unit, and the daemon is no longer one. Those are lost, and
    saying otherwise would be the unbacked claim this whole change is about.

    What does not need a unit is applied here: NoNewPrivileges, which is a process flag
    inherited across exec, and a umask the unit did not even set. The panel does not get
    either -- it forks the user's applications, and no_new_privs on it would reach every
    one of them, which is the defect the unit's own comment records.
    """
    os.umask(0o077)

    # The panel is shielded from the OOM killer with OOMScoreAdjust=-500 because the
    # session cannot lose it; the daemon inherits that shield and has no claim to it, so
    # it goes back to being an ordinary candidate. Only upwards: an unprivileged process
    # may raise oom_score_adj and not lower it, so a value already at or above zero --
    # anywhere but under the panel's unit -- is left as it was found rather than being
    # written back and refused.
    with open("/proc/self/oom_score_adj", "r+", encoding="ascii") as adjustable:
        if int(adjustable.read().strip() or "0") < 0:
            adjustable.seek(0)
            adjustable.write("0\n")

    if _LIBC.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
        raise OSError(ctypes.get_errno(), "prctl(PR_SET_NO_NEW_PRIVS) failed")


def spawn(argv, end, variable, preexec_fn=None):
    """Start `argv` with `end` as an inherited descriptor named by `variable`.

    pass_fds keeps that one descriptor open across the exec and closes every other, so
    neither child inherits the peer's end. Each end then belongs to exactly one process,
    which is what makes closing it tell the other side that its peer is gone.
    """
    return subprocess.Popen(
        argv,
        env={**os.environ, variable: str(end.fileno())},
        pass_fds=(end.fileno(),),
        preexec_fn=preexec_fn,
    )


def stop(child):
    """SIGTERM, then SIGKILL if it is still there. Never blocks for good."""
    child.terminate()
    try:
        child.wait(timeout=TERMINATE_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        log(f"pid {child.pid} ignored SIGTERM for {TERMINATE_TIMEOUT_SECONDS}s; killing")
        child.kill()
        child.wait()


def run_once(with_daemon):
    """Run the panel, and the daemon beside it on a shared socket pair.

    Returns the program that exited first, its exit code (negative for a signal, as
    os.waitstatus_to_exitcode reports one) and the other child, or None when the panel
    ran alone -- either because the caller asked for it or because the daemon could not
    be started at all, which is reported here and costs notifications, never the panel.
    """
    daemon = None
    panel_end = None
    if with_daemon:
        daemon_end, panel_end = socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM)
        with daemon_end:
            try:
                daemon = spawn(
                    DAEMON_SCOPE + [DAEMON],
                    daemon_end,
                    "DAEMON_NOTIFICATIONS_FD",
                    preexec_fn=harden,
                )
            except (OSError, subprocess.SubprocessError) as error:
                # The daemon could not even be started: the binary is missing, SELinux
                # refused the exec, harden() failed, the fork did not happen. Letting
                # that out of here would start no panel at all and leave the unit to
                # restart into the same wall until it failed for good -- the session
                # losing its dock and launcher over the notification daemon, which is
                # exactly what this wrapper exists to prevent. The panel runs without
                # it, for the rest of the session.
                log(
                    f"cosmic-notifications could not be started ({error}); running "
                    f"cosmic-panel without it -- this session has no notifications",
                    ERR,
                )
                panel_end.close()
                panel_end = None

    if panel_end is None:
        panel = subprocess.Popen([PANEL])
        return PANEL, panel.wait(), None

    with panel_end:
        try:
            panel = spawn([PANEL], panel_end, "PANEL_NOTIFICATIONS_FD")
        except BaseException:
            # Nothing here can substitute for the panel, so this one goes up; the daemon
            # must not be left behind running.
            stop(daemon)
            raise
    # Leaving the blocks hands both ends to the children alone.

    first, status = os.wait()
    code = os.waitstatus_to_exitcode(status)
    for child, command in ((daemon, DAEMON), (panel, PANEL)):
        if child.pid == first:
            # os.wait() already reaped it; tell Popen so it does not wait on it again.
            child.returncode = code
            other = panel if child is daemon else daemon
            return command, code, other
    raise AssertionError(f"waited on pid {first}, which is neither child")


def recent_failures(failures, now):
    """The daemon exits still inside the window, with this one added.

    Kept separate from the loop because it is the whole give-up policy: what counts as
    "still failing" is this and nothing else.
    """
    return [when for when in failures if now - when < FAILURE_WINDOW_SECONDS] + [now]


def main():
    failures = []
    delay = 1
    while True:
        exited, code, other = run_once(with_daemon=len(failures) < GIVE_UP_AFTER)

        if exited == PANEL:
            if other is not None:
                stop(other)
            log(f"cosmic-panel exited ({code}); the session is over")
            return code if code >= 0 else 1

        stop(other)
        failures = recent_failures(failures, time.monotonic())
        if len(failures) == 1:
            # Nothing recent: the daemon had been healthy, so start the backoff over.
            delay = 1

        if len(failures) >= GIVE_UP_AFTER:
            log(
                f"cosmic-notifications exited {len(failures)} times within "
                f"{FAILURE_WINDOW_SECONDS}s (last exit {code}); running cosmic-panel "
                f"without it -- this session has no notifications",
                ERR,
            )
            continue

        log(
            f"cosmic-notifications exited ({code}); restarting it and cosmic-panel on a "
            f"new socket in {delay}s"
        )
        time.sleep(delay)
        delay = min(delay * 2, BACKOFF_CEILING_SECONDS)


if __name__ == "__main__":
    sys.exit(main())
