# Athanor OS Strict Seccomp BPF Policy for CrosVM MicroVM Enclaves
# Installed read-only under /usr by the athanor-gatekeeper-rs package; the Gatekeeper
# refuses to launch crosvm unless this file and every parent directory are root-owned
# and not writable by group or others.
# Explicitly block dangerous syscalls inside VM sandbox context: bpf, ptrace, userfaultfd
bpf: return 1
ptrace: return 1
userfaultfd: return 1
# Allow baseline system calls required for application execution
read: 1
write: 1
openat: 1
close: 1
fstat: 1
mmap: 1
mprotect: 1
munmap: 1
brk: 1
rt_sigaction: 1
rt_sigprocmask: 1
ioctl: 1
pread64: 1
pwrite64: 1
statfs: 1
exit_group: 1
futex: 1
epoll_wait: 1
epoll_ctl: 1
epoll_create1: 1
eventfd2: 1
timerfd_create: 1
timerfd_settime: 1
clone: 1
clone3: 1
