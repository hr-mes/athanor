module athanor_nix_daemon 1.0;

require {
    type init_t;
    type default_t;
    class sock_file { create write unlink };
}

# systemd (init_t) manages the Nix daemon socket, which the Fedora nix-daemon.socket unit
# listens on at /nix/var/nix/daemon-socket/socket. On this ostree image /nix is a bind
# mount of /var/nix (see nix.mount), so the socket directory carries the default_t label
# the policy assigns to the /nix path rather than a Nix-specific type -- the Fedora
# SELinux policy defines no nix type at all. Without this rule PID1 cannot create the
# listening socket (avc denied { create write unlink } for init_t on a default_t
# sock_file), the socket unit fails, and a non-root user gets 'Permission denied' on the
# store lock because there is no daemon to proxy the privileged store operations. This is
# the minimal, named permission that lets the daemon socket work; SELinux stays enforcing.
allow init_t default_t:sock_file { create write unlink };
