# Read by pam_env from the greeter's PAM stack, before pam_systemd registers the
# session. pam_systemd takes both from the PAM environment and uses them to attach
# the session to a seat; without them the session is registered seatless and
# libseat can find nothing to open.
#
# XDG_VTNR matches `vt = 1` in greetd.toml. seat0 is the only seat that knows
# kernel VTs, so a VT number is meaningful on no other.
XDG_SEAT DEFAULT=seat0
XDG_VTNR DEFAULT=1
