#!/usr/bin/sh
# athanor-desktop - cosmic-comp's client for the session.
#
# cosmic-comp hands its client WAYLAND_DISPLAY (and DISPLAY, for Xwayland) and exits when
# the client exits, so this process is the session's anchor. It is the only process that
# has the compositor's WAYLAND_DISPLAY in its environment, so it is the one that must
# publish it to the user manager -- a unit started by the manager inherits the manager's
# environment, not this script's. It then starts the desktop through
# athanor-session.target and waits on it.
#
# The target requires athanor-desktop.service, the readiness gate, which blocks until the
# compositor answers a Wayland round-trip, so no graphical unit starts before cosmic-comp
# can serve a surface. The session lasts exactly as long as the target is active, and
# `systemctl --user stop athanor-session.target` is the logout: the wait returns, this
# process exits, cosmic-comp exits, greetd shows the greeter again.
#
# The screen locker and the idle daemon are not units: they run as children of this
# process, the way cosmic-session starts cosmic-greeter and cosmic-idle. Both need a
# parent inside the logind session. cosmic-greeter, run as a user other than
# cosmic-greeter, is the locker: it finds its session with GetSessionByPID on its parent
# PID, waits for the session's Lock signal and holds the sleep inhibitor that locks the
# screen before suspend. cosmic-idle turns the screens off after the configured idle time,
# locks the session with `loginctl lock-session` half a second later and suspends after
# its own timeout. A child of the user manager belongs to no session, so as a user unit
# the locker would never see a Lock signal and the idle lock would lock nothing.
set -eu
systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

# Runs a session component again whenever it exits, as cosmic-session does, for as long
# as the anchor process lives. The anchor is this process: its PID stays the same once
# it execs systemctl below, and when the session ends the components lose the display,
# exit, and the loop stops.
#
# A component that keeps failing is not restarted every second forever. The fifth exit
# within 60 seconds is logged at err priority in the journal, naming the component --
# a session with no locker is a session that never locks -- and from then on the delay
# doubles at every exit, up to 60 seconds. Once 60 seconds pass without five exits, the
# count and the delay start again from the beginning.
# ponytail: liveness by PID; a PID reused within one retry delay would keep the loop
# alive until that process exits. A pidfd-based supervisor would close it if it matters.
session_component() {
    anchor=$1
    shift
    delay=1
    failures=0
    window_start=$(date +%s)
    while kill -0 "$anchor" 2> /dev/null; do
        if "$@"; then
            status=0
        else
            status=$?
        fi
        now=$(date +%s)
        if [ $((now - window_start)) -gt 60 ]; then
            window_start=$now
            failures=0
            delay=1
        fi
        failures=$((failures + 1))
        if [ "$failures" -ge 5 ]; then
            if [ "$failures" -eq 5 ]; then
                echo "$1 exited 5 times within 60 seconds (last status $status); retrying with backoff" |
                    systemd-cat -p err -t athanor-desktop
            fi
            delay=$((delay * 2))
            if [ "$delay" -gt 60 ]; then
                delay=60
            fi
        fi
        echo "athanor-desktop: $1 exited with status $status, restarting in ${delay}s" >&2
        sleep "$delay"
    done
}

session_component "$$" cosmic-greeter &
session_component "$$" cosmic-idle &

exec systemctl --user start --wait athanor-session.target
