#!/usr/bin/sh
# athanor-session - the session greetd starts once the user is authenticated.
#
# greetd runs it as the user, with the environment PAM built plus what the greeter asked
# for in StartSession. The compositor is cosmic-comp. The desktop -- shell, dock -- is a
# set of systemd user units gathered by athanor-session.target, which athanor-desktop,
# the compositor's client, starts once the display exists and holds open for the life
# of the session.
set -eu

# Whatever the previous session left in the user manager -- units still active behind
# a compositor that died, units failed -- would have this one start half-way. Clear it.
systemctl --user stop athanor-session.target
systemctl --user reset-failed

export XDG_CURRENT_DESKTOP=Athanor
export XDG_SESSION_TYPE=wayland

# The USB policy is relaxed for an unlocked session; the hook does nothing where
# usbguard is not running.
/usr/bin/athanor-usbguard-hook unlock

# cosmic-comp runs athanor-desktop as its client and exits when it exits. systemd-cat
# puts the compositor's own output in the journal under "athanor-session".
exec systemd-cat -t athanor-session cosmic-comp /usr/bin/athanor-desktop
