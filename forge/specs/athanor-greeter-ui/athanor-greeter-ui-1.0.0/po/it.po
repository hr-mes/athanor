msgid "Too many authentication steps."
msgstr "Troppi passaggi di autenticazione."

msgid "High contrast"
msgstr "Contrasto elevato"

msgid "Keyboard layout: {layout}"
msgstr "Disposizione della tastiera: {layout}"

msgid "Suspend"
msgstr "Sospendi"

msgid "Restart"
msgstr "Riavvia"

msgid "Shut down"
msgstr "Spegni"

