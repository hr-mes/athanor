Return enum drm_mode_status from the nvidia-drm mode_valid hook

drm_connector_helper_funcs.mode_valid returns enum drm_mode_status, but
nv_drm_connector_mode_valid returns int. C accepts the assignment because an enum
is compatible with its underlying integer type; kCFI hashes the two apart, so
every call from __drm_helper_update_and_validate traps. Seen on hardware as the
first kCFI failure of the -nvidia image, when nvidia-drm registers the display.

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 560f444..8be53c4 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -451,7 +451,7 @@ static int nv_drm_connector_get_modes(struct drm_connector *connector)
     return count;
 }
 
-static int nv_drm_connector_mode_valid(struct drm_connector    *connector,
+static enum drm_mode_status nv_drm_connector_mode_valid(struct drm_connector    *connector,
 #if defined(NV_DRM_CONNECTOR_HELPER_FUNCS_MODE_VALID_HAS_CONST_MODE_ARG)
                                        const struct drm_display_mode *mode)
 #else
