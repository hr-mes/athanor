# Athanor OS: environment of the NVIDIA kernel modules (docs/architecture/doc_kernel_build.md,
# section 10, phase K4). Same pinned base as the kernel builder, but only what nvidia.sh
# needs: the LLVM toolchain the kernel is compiled with (kCFI), Kbuild from the
# kernel-devel tree extracted from the RPM, kmod for modinfo, openssl and sign-file for
# the signing. No rust, pahole or koji: a smaller and faster image than the builder, and
# it does not touch the builder's Containerfile (which is an input of the kernel reuse).
FROM registry.fedoraproject.org/fedora:43@sha256:bd5576db3197e265cdfb278db6d7de53c250ba9edde7be61c6088ce235cd6cce

RUN printf 'install_weak_deps=False\nkeepcache=False\n' >> /etc/dnf/dnf.conf

RUN dnf -y install \
      clang lld llvm make gcc elfutils-libelf-devel \
      rpm cpio curl git kmod openssl findutils diffutils \
    && dnf clean all
