# The base image is built by the separate repository hr-mes/ermete-base-nvidia and
# has not been renamed: no athanor-base-nvidia image has ever been published.
FROM ghcr.io/hr-mes/ermete-base-nvidia:latest
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG FEDORA_VERSION=43
ENV FEDORA_VERSION=$FEDORA_VERSION
ARG TETRAGON_VERSION=v1.3.0


# TIER 0: BEDROCK HARDWARE & KERNEL FOUNDATION
RUN --mount=type=bind,from=ghcr.io/hr-mes/athanor-forge-tier0-repo:latest,source=/,target=/mnt/tier0-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    base_kernel=$(rpm -qa kernel kernel-core 'kernel-modules*' 'kernel-uki-virt*') && \
    if [ -n "$base_kernel" ]; then \
        echo "Tier 0: Removing the base image kernel: bootc supports one kernel per image and Azoth is installed below..." && \
        dnf5 remove -y --no-autoremove $base_kernel; \
    fi && \
    BASE_CONFIG=$(find /mnt/tier0-repo -name "athanor-base-config*.rpm" | head -n 1) && \
    if [ -n "$BASE_CONFIG" ]; then \
        echo "Tier 0: Installing core Athanor Forge base configuration..." && \
        rpm -e --nodeps fedora-logos || true && \
        rpm -Uvh --replacefiles --replacepkgs --nodeps "$BASE_CONFIG"; \
    fi && \
    RAW_RPM_LIST=$(find /mnt/tier0-repo -name "*.rpm" 2>/dev/null | awk '!/systemd-standalone-|.*-free-.*\.rpm|glibc32|kernel-debug|rpm-.*\.rpm|fedora-release-|selinux-policy|athanor-base-config|-doc-|debuginfo|debugsource/ && (!/-devel-/ || /kernel-devel/)' || true) && \
    RPM_LIST="" && \
    for rpm in $RAW_RPM_LIST; do \
        if [[ "$rpm" == *kmod-nvidia-* ]] && [[ "$rpm" != *chimera* ]]; then \
            continue; \
        fi; \
        RPM_LIST="$RPM_LIST $rpm"; \
    done && \
    if [ -n "$RPM_LIST" ]; then \
        echo "Tier 0: Installing Bedrock hardware, kernel Chimera & NVIDIA dependencies..." && \
        dnf5 install -y --allowerasing --setopt=install_weak_deps=False --setopt=tsflags=nodocs $RPM_LIST; \
    fi && \
    rm -rf /usr/lib/firmware/{mellanox,qlogic,netronome,liquidio,cxgb4,bnx2x,cavium,dpaa2}

# Tier 0: Install Cilium Tetragon eBPF Runtime Security is now delegated to athanor-tetragon RPM

# TIER 1: CORE USERSERVICE, DBUS & POLICYKIT
RUN --mount=type=bind,from=ghcr.io/hr-mes/athanor-forge-tier1-repo:latest,source=/,target=/mnt/tier1-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    echo "Tier 1: Installing Scudo Hardened Allocator (compiler-rt), Keylime & UKI tools..." && \
    dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs compiler-rt keylime-tenant keylime-agent systemd-ukify systemd-boot-unsigned sbsigntools openssl tpm2-tools cryptsetup dracut && \
    if find /mnt/tier1-repo -name "*.rpm" 1> /dev/null 2>&1; then \
        echo "Tier 1: Installing Core User Services, DBus & Policies..." && \
        RPM_LIST=$(find /mnt/tier1-repo -name "*.rpm" ! -name "*-devel-*" ! -name "*-doc-*" ! -name "*debuginfo*" ! -name "*debugsource*" ! -name "*astro-toolchain*" ! -name "*sccache*" ! -name "*buildah*" ! -name "*mold*" ! -name "*osbuild*" ! -name "*cargo-tools*") && \
        if [ -n "$RPM_LIST" ]; then \
            dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs $RPM_LIST; \
        fi; \
    fi

# TIER 2: DESIGN SYSTEM & STATIC ASSETS
RUN --mount=type=bind,from=ghcr.io/hr-mes/athanor-forge-tier2-repo:latest,source=/,target=/mnt/tier2-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    if find /mnt/tier2-repo -name "*.rpm" 1> /dev/null 2>&1; then \
        echo "Tier 2: Installing Design System & Static Assets..." && \
        RPM_LIST=$(find /mnt/tier2-repo -name "*.rpm" ! -name "*-devel-*" ! -name "*-doc-*" ! -name "*debuginfo*" ! -name "*debugsource*" ! -name "*astro-toolchain*" ! -name "*sccache*" ! -name "*buildah*" ! -name "*mold*" ! -name "*osbuild*" ! -name "*cargo-tools*") && \
        if [ -n "$RPM_LIST" ]; then \
            dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs $RPM_LIST; \
        fi; \
    fi

# TIER 3: AGILE RUST SHELL & APPS
RUN --mount=type=bind,from=ghcr.io/hr-mes/athanor-forge-tier3-repo:latest,source=/,target=/mnt/tier3-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    if find /mnt/tier3-repo -name "*.rpm" 1> /dev/null 2>&1; then \
        echo "Tier 3: Installing Agile Rust Shell & Apps..." && \
        RPM_LIST=$(find /mnt/tier3-repo -name "*.rpm" ! -name "*-devel-*" ! -name "*-doc-*" ! -name "*debuginfo*" ! -name "*debugsource*" ! -name "*astro-toolchain*" ! -name "*sccache*" ! -name "*buildah*" ! -name "*mold*" ! -name "*osbuild*" ! -name "*cargo-tools*") && \
        if [ -n "$RPM_LIST" ]; then \
            dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs $RPM_LIST; \
        fi; \
    fi

# FLATPAK MANIFEST: the applications are provisioned on the installed system, not at
# build time. Extra-data apps such as Chrome run an apply_extra script under
# bubblewrap, which a build container cannot host, and bootc carries /var into the
# first deployment only.
COPY forge/config/packages.json /usr/share/athanor/packages.json
RUN dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs flatpak jq

COPY system/scripts/ /scripts/


# TPM 2.0 PCR Sealing Provisioning Service & Script for LUKS /var/home
COPY forge/specs/athanor-secure-boot/SOURCES/usr/libexec/athanor-tpm-luks-seal.sh /usr/libexec/athanor-tpm-luks-seal.sh
COPY forge/specs/athanor-secure-boot/SOURCES/usr/lib/systemd/system/athanor-tpm-luks-seal.service /usr/lib/systemd/system/athanor-tpm-luks-seal.service
RUN chmod +x /usr/libexec/athanor-tpm-luks-seal.sh

# Declarative Systemd presets & sysusers
RUN authselect enable-feature with-systemd-homed && \
    systemctl enable tetragon.service systemd-sysext.service systemd-homed.service athanor-tpm-rollback-check.service athanor-tpm-rollback-update.service athanor-tpm-luks-seal.service && systemd-sysusers && systemctl preset-all && systemctl --global preset-all

# Initramfs & Unified Kernel Image (UKI) generation
RUN --mount=type=secret,id=uki_key,required=false \
    --mount=type=secret,id=uki_cert,required=false \
    --mount=type=secret,id=uki_crt,required=false \
    /bin/bash /scripts/assemble_uki.sh

# Hardening & OSTree cleanup
RUN dnf5 remove -y --no-autoremove \
        gcc make llvm-static rust-std-static mesa-dxil-devel \
        edk2-aarch64 qemu-user qemu-user-static distribution-gpg-keys-copr \
        nodejs-docs glibc-all-langpacks python3-botocore kernel-debug kernel-debug-core kernel-debug-modules kernel-debug-modules-core kernel-debug-modules-extra && \
    for d in /usr/lib/modules/*; do if [ -d "$d" ] && [ ! -e "$d/vmlinuz" ] && [ ! -L "$d/vmlinuz" ]; then rm -rf "$d"; fi; done && \
    rm -f /etc/machine-id && touch /etc/machine-id && \
    rm -rf /scripts /etc/pki/secureboot/private /etc/pki/uki/*.key && \
    dnf5 clean all && \
    find /tmp /run /etc/NetworkManager/system-connections -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true && \
    rm -rf /var/lib/dnf5/* /var/tmp/* /var/log/*

# Image Validation & Linting
RUN ls -la /usr/lib/modules/ && bootc container lint
